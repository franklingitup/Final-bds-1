# Shared local development environment variables.
# Copy to .env and adjust as needed: cp .env.example .env

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
DATABASE_URL=postgres://platform:platform@localhost:5432/platform?sslmode=disable

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Message broker (NATS / JetStream) ---
NATS_URL=nats://localhost:4222
NATS_STREAM=EVENTS
NATS_DLQ_STREAM=EVENTS_DLQ
NATS_SUBJECT_PREFIX=evt

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=platform-artifacts

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=info

# --- Auth ---
JWT_SIGNING_KEY=dev-only-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
