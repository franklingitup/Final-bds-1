# Shared local development environment variables.
# Copy to .env and adjust as needed: cp .env.example .env

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
DATABASE_URL=postgres://platform:platform@localhost:5432/platform?sslmode=disable

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Message broker (NATS / JetStream) ---
NATS_URL=nats://localhost:4222
NATS_STREAM=EVENTS
NATS_DLQ_STREAM=EVENTS_DLQ
NATS_SUBJECT_PREFIX=evt

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=platform-artifacts

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=info

# --- Observability Service ---
# Prometheus URL for metrics queries
PROMETHEUS_URL=http://localhost:9090
# Loki URL for log queries
LOKI_URL=http://localhost:3100

# --- Auth ---
JWT_SIGNING_KEY=dev-only-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Session Management ---
# Session TTL (default: 24h)
SESSION_TTL=24h
# Refresh token rotation enabled
REFRESH_TOKEN_ROTATION=true

# --- Rate Limiting ---
# Use Redis for distributed rate limiting (default: memory for dev)
RATE_LIMIT_REDIS_ENABLED=false
# Global rate limit (requests per minute)
RATE_LIMIT_RPM=60
# Burst size
RATE_LIMIT_BURST=10

# --- KMS/Encryption ---
# Master encryption key (base64-encoded 32 bytes) - generate with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=

# --- SSO/OIDC ---
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft/Azure AD
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Okta
OKTA_DOMAIN=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# --- SAML ---
# SAML Entity ID (defaults to platform URL)
SAML_ENTITY_ID=
# SAML ACS URL
SAML_ACS_URL=
# SAML Certificate (PEM-encoded)
SAML_CERTIFICATE=
SAML_PRIVATE_KEY=

# --- SCIM ---
# SCIM bearer token for IdP provisioning
SCIM_BEARER_TOKEN=

# --- Gateway ---
# CORS allowed origins (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- GitHub Integration ---
# Register an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Base URL for webhooks (must be publicly accessible for GitHub to call)
GITHUB_WEBHOOK_BASE_URL=http://localhost:8084
# Base64-encoded 32-byte key for encrypting tokens (generate with: openssl rand -base64 32)
GITHUB_ENCRYPTION_KEY=

# --- Build Service ---
# Enable background build worker
BUILD_WORKER_ENABLED=false

# --- Domain Service ---
# ACME directory URL (use staging for testing)
# Production: https://acme-v02.api.letsencrypt.org/directory
# Staging: https://acme-staging-v02.api.letsencrypt.org/directory
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# Email for Let's Encrypt account
ACME_EMAIL=
# Base64-encoded 32-byte key for encrypting certificates (generate with: openssl rand -base64 32)
CERTIFICATE_ENCRYPTION_KEY=

# --- Notification Service ---
# Enable background notification worker
NOTIFICATION_WORKER_ENABLED=true
# SMTP configuration (for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=BDS Platform

# --- Provisioning Service ---
# Base64-encoded 32-byte key for encrypting cloud credentials (generate with: openssl rand -base64 32)
CREDENTIAL_ENCRYPTION_KEY=
# Platform URL for agent bootstrap commands
PLATFORM_URL=http://localhost:8080
# Agent container image
AGENT_IMAGE=ghcr.io/bdsplatform/platform-agent:latest

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
